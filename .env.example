# Provider backend. Compatible third-party gateways use the official OpenAI SDK.
FLYAGENT_MODEL_PROVIDER=openai_compatible
FLYAGENT_MODEL_NAME=
FLYAGENT_MODEL_API_KEY=
FLYAGENT_MODEL_BASE_URL=
# Provider wire API: chat_completions or responses.
FLYAGENT_MODEL_API_PROTOCOL=chat_completions
# Explicitly request and aggregate Chat Completions SSE responses.
FLYAGENT_MODEL_STREAM=false
FLYAGENT_MODEL_TIMEOUT_SEC=60
FLYAGENT_MODEL_TIMEOUT_RETRIES=1
FLYAGENT_MODEL_CONNECTION_RETRIES=8
FLYAGENT_MODEL_RETRY_DEADLINE_SEC=600
FLYAGENT_AGENT_MAX_TOOL_ROUNDS=10
FLYAGENT_AGENT_MAX_CONSECUTIVE_PROTOCOL_REJECTIONS=6
FLYAGENT_AGENT_TASK_PROGRESS_REMINDER_INTERVAL=5
# Native model-authored user-facing text: en or zh.
FLYAGENT_AGENT_OUTPUT_LANGUAGE=en

# Optional private-key path used by remote simulator map configurations.
# Keep the real path only in the ignored local .env file.
FLYAGENT_SSH_KEY=

# Optional provider thinking toggle: enabled / disabled; empty preserves provider default.
FLYAGENT_MODEL_THINKING_MODE=
# Provider extension: thinking_object (legacy default) or enable_thinking.
FLYAGENT_MODEL_THINKING_WIRE_FORMAT=thinking_object
# OpenAI reasoning effort: none / minimal / low / medium / high / xhigh.
# Keep empty when using the provider-specific thinking toggle above.
FLYAGENT_MODEL_REASONING_EFFORT=
# Compactor response format: json_schema (strict provider mode) or json_object.
FLYAGENT_MODEL_STRUCTURED_OUTPUT_FORMAT=json_schema
