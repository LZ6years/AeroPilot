{
  "uav_flow_repo_path": ".external_refs/UAV-Flow/UAV-Flow-Eval",
  "output_dir": "evaluation/benchmarks/uav_flow/outputs",
  "run_root": "runs",
  "map_config_path": "configs/maps/unrealcv_actor_control.example.json",
  "map_id": "downtownwest_local_unrealcv",
  "execution_mode": "dry",
  "observation_profile_path": null,
  "headless": true,
  "save_artifacts": false,
  "generate_html_review": true,
  "instruction_field": "instruction_unified",
  "case_ids": null,
  "classes": ["Turn", "Move", "Approach"],
  "limit_per_class": 1,
  "enable_sr_judge": false,
  "env_path": ".env",
  "parser_mode": "model",
  "shutdown_policy": "hover",
  "runtime_loop_guard_windows": 40,
  "enable_visual_diagnostics": false,
  "visual_diagnostics_max_frames": 12,
  "enable_action_planner_debug": false,
  "planner_depth_input": "off",
  "stmr_mode": "off",
  "stmr_prior": "default_uav_prior",
  "stmr_max_queries": 16,
  "stmr_device": "auto",
  "action_config_overrides": {
    "linear_velocity_mps": 1.0,
    "move_duration_sec": 1.0,
    "yaw_step_deg": 10.0
  },
  "safety_overrides": {
    "max_yaw_step_deg": 90.0,
    "max_linear_velocity_mps": 3,
    "max_move_duration_sec": 3,
    "max_yaw_scan_extent_deg": 540.0
  }
}
